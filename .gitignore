# ---- Compliance: footage and derived data must never be committed ----
# Real footage, labels and outputs live OUTSIDE the repo (e.g. ~/hackathon_data/).

# Video
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.mpg
*.mpeg
# Images (only our own synthetic footage is allowed, in docs/synthetic/)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tif
*.tiff
*.webp
# Arrays / caches / per-frame dumps
*.npy
*.npz
*.pkl
*.pickle
*.jsonl
*.parquet
*.h5
*.hdf5
# Model files
*.task
*.pth
*.pt
*.ckpt
*.onnx
*.tflite
*.safetensors
*.bin
# Data folders
data/
outputs/
frames/
labels/
hackathon_data/

# Allow-list: images we made from our OWN footage (no faces/screens/documents)
!/docs/synthetic/
!/docs/synthetic/**

# ---- Python / tooling ----
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.DS_Store
